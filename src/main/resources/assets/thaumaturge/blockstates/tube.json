{
  "multipart": [
    { "apply": { "model": "thaumaturge:block/tube_core" } },
    { "when": { "down": "true" },  "apply": { "model": "thaumaturge:block/tube_side" } },
    { "when": { "up": "true" },    "apply": { "model": "thaumaturge:block/tube_side", "x": 180 } },
    { "when": { "north": "true" }, "apply": { "model": "thaumaturge:block/tube_side", "x": 270 } },
    { "when": { "south": "true" }, "apply": { "model": "thaumaturge:block/tube_side", "x": 90 } },
    { "when": { "west": "true" },  "apply": { "model": "thaumaturge:block/tube_side", "x": 270, "y": 270 } },
    { "when": { "east": "true" },  "apply": { "model": "thaumaturge:block/tube_side", "x": 270, "y": 90 } }
  ]
}